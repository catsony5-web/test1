{
  "name": "personal-budget-web",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first spending analysis web app and developer tooling",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "check": "node scripts/check.mjs",
    "cache:sync": "node scripts/sync-cache-manifest.mjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:qa": "node scripts/run-qa.mjs",
    "verify": "npm run check && npm test && npm run test:qa",
    "build": "node scripts/build-web.mjs"
  }
}
